{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build phone sales receipt",
      "type": "process",
      "command": "g++",
      "args": [
        "-g",
        "-Wall",
        "-Wextra",
        "${workspaceFolder}/phonesales_system.cpp",
        "-o",
        "${workspaceFolder}/output/phonesales_system.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    }
  ]
}
